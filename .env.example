# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Google Sheets — сервисный аккаунт Google Cloud.
# Если не заполнить, бот работает, но заявки пишутся только в data/applications.jsonl
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_NAME=Заявки

# Расписание напоминаний
TIMEZONE=Asia/Bishkek
LESSON_TIME=20:00

# Google Таблица через Apps Script — см. google-apps-script.gs
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_TOKEN=

# Секретный код: кто пришлёт боту /admin <код>, станет администратором
ADMIN_CODE=

# Telegram ID администраторов через запятую — им доступны /applications и /stats
ADMIN_IDS=

# Куда складывать список подписчиков и резервные копии заявок
DATA_DIR=./data
